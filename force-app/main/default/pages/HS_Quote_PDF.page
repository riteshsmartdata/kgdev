                {!QuoteRequestDetails.Account__r.EBS_Num__c}              
            </td>
        </tr>
        <tr>
            <td>
                Account Name:
            </td>
            <td>
                {!QuoteRequestDetails.Account__r.Name}
            </td>
        </tr>
        <tr>
            <td>
                Account Address:
            </td>
            <td>
                {!QuoteRequestDetails.Account__r.ShippingStreet}, {!QuoteRequestDetails.Account__r.ShippingCity}, 
                {!QuoteRequestDetails.Account__r.ShippingState}, {!QuoteRequestDetails.Account__r.ShippingPostalCode}, 
                {!QuoteRequestDetails.Account__r.ShippingCountry}
            </td>
        </tr>
        
        <tr>
            <td>
                Account Contact:
