    <hr/><br/>
    
    <apex:repeat value="{!QuoteRequestDetails.Quote_Products__r}" var="Product" id="theRepeat">
        
        <b>Item #/Name:</b> {!Product.Products__r.Product_ID__c} / {!Product.Products__r.Name} <br/>
        <b>Description:</b> {!Product.Description__c} <br/> <!-- To more detail check SF-426 Jira -->
        <b>Imprint Location:</b> {!Product.Imprint_Location__c}  <br/>
        <b>Imprint Colors:</b> {!Product.Number_of_Imprint_Colors__c}  <br/>
        <b>Imprint Methods:</b> {!Product.Imprint_Method__c} <br/>
        <b>Packing (approx.):</b> {!Product.Packing_approx__c} <br/>
        <apex:outputText rendered="{!IF(Product.Sample_Lead_Time__c != null, true, false)}">
            <b>Sample Lead Time:</b> {!Product.Sample_Lead_Time__c} working days <br/>
        </apex:outputText>
        <apex:outputText rendered="{!IF(Product.Production_Lead_Time__c != null, true, false)}">
            <b>Production Lead Time:</b> {!Product.Production_Lead_Time__c } working days <br/>
        </apex:outputText>
        <apex:outputText rendered="{!IF(Product.Ocean_Transit__c != null, true, false)}">
            <b>Ocean Transit:</b> {!Product.Ocean_Transit__c} days <br/>
        </apex:outputText> 
        <br/>
        <table>
            <tr>
            <!--    <td>
                    Quantity:<hr/> 
