public class AgentWorkCleanup_Batch implements  Database.Batchable<SObject> {
    public Database.QueryLocator start(Database.BatchableContext bc) {
        String query ='';
        if(test.isRunningTest()){
            query = 'SELECT Id, CreatedDate FROM AgentWork';
        }
        else{
            //query = 'SELECT Id FROM AgentWork WHERE CreatedDate <= 2020-12-31T00:00:00Z ORDER BY CreatedDate asc';
            query = 'SELECT Id,CreatedDate FROM AgentWork WHERE CreatedDate < LAST_N_DAYS:365';
        }
        return Database.getQueryLocator(query);
    }
    
    public void execute(Database.BatchableContext bc, List<AgentWork> AWlist) {

        List<AgentWork> ToBeDeletedAgentWork = new List<AgentWork>();
        for(AgentWork  agw:AWlist){
           /*  AgentWork obj = new AgentWork();
            obj.id=agw.id; */
            ToBeDeletedAgentWork.add(agw);
        } 

        if(ToBeDeletedAgentWork.size()>0){
            delete ToBeDeletedAgentWork;
        }
    }
        
